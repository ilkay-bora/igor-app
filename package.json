{
  "name": "igor",
  "private": true,
  "description": "Local, agent-ready AI video editor and media studio",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @igor/studio",
    "build": "npm run build -w @igor/studio",
    "lint": "npm run lint -w @igor/studio",
    "typecheck": "tsc --noEmit -p apps/studio",
    "desktop": "npm run start -w @igor/desktop",
    "desktop:build": "npm run build && npm run start -w @igor/desktop"
  },
  "engines": {
    "node": ">=20"
  }
}
