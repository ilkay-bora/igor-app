# Password for the local web UI (any string). Required.
APP_TOKEN=change-me

# Path to your ComfyUI install (folder containing main.py and venv/).
# Defaults to ../ComfyUI relative to apps/studio.
COMFYUI_DIR=
COMFYUI_URL=http://127.0.0.1:8188

# Optional cloud providers, bring your own key. Usually entered in the app
# instead (first-run setup or Ayarlar), which saves to data/settings.json and
# takes precedence over these. Values here act as a fallback.
GEMINI_API_KEY=
POLLINATIONS_API_KEY=
